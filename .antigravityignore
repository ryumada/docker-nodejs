# .antigravityignore
# Stop background token drain by excluding generated, compiled, and massive static files.

# 1. Dependency Directories (The biggest token sinks)
node_modules/
.venv/
venv/
__pycache__/

# 2. Build Artifacts & Caches
.next/
.turbo/
.cache/
dist/
build/
out/
*.tsbuildinfo

# 3. Lockfiles (Thousands of non-semantic lines)
package-lock.json
yarn.lock
pnpm-lock.yaml

# 4. Version Control & IDE States
.git/
.vscode/
.idea/

# 5. Media & Minified Assets (No reasoning value)
*.svg
*.png
*.jpg
*.jpeg
*.ico
*.gif
*.webp
*.woff
*.woff2
*.ttf
*.min.js
*.min.css

# 6. Logs & Databases
*.log
*.sqlite
*.sqlite3

# 7. Environment Variables & Backups
.env
.env.backup_*
.env.example.merge
